{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "yad-beyad",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yad-beyad",
      "database_id": "39c86c6e-7ee3-4c14-8f6a-938c939d66f6"
    }
  ]
}
